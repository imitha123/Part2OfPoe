<Window x:Class="Part2OfPoe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Part2OfPoe"

        mc:Ignorable="d"
        Title="ChatBot" Height="450" Width="800"
  
        >
    <Grid>

        <Grid x:Name="WelcomeGrid"
              Visibility="Visible"
              >

            <Grid.Background>

                <ImageBrush ImageSource="/cybersecurity_dark_blue_background.jpg"/>
            

            </Grid.Background>

            <Image Source="/cybersecurity_ai_chatbot_logo.jpg"
       Height="250"
       Width="250"
       Margin="0,0,0,150">

                <Image.Clip>
                    <EllipseGeometry Center="125,125"
                         RadiusX="115"
                         RadiusY="115"/>
                </Image.Clip>
                
                

            </Image>

            <Button 
                Content="Start ChatBot" 
                Height="50" Width="250"
                Margin="0,170,0,0"
                Click="start_ai"
                FontFamily="Segoe Print"
                FontSize="15"
                Cursor="Hand"
                ToolTip="Start ChatBot"
                ToolTipService.InitialShowDelay="100"
               >

                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Black"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderBrush" Value="#2AA8FF"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="FontWeight" Value="Medium"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E7FCB"/>
                                <Setter Property="BorderBrush" Value="#1E7FCB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1669A3"/>
                                <Setter Property="BorderBrush" Value="#1669A3"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    </Button.Style>


                    <Button.Effect>
                    <DropShadowEffect BlurRadius="20"
                          ShadowDepth="0"
                          Opacity="0.5"
                          Color="Wheat"
                                      />
                    
                </Button.Effect>
                

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    CornerRadius="25"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>


            </Button>


        </Grid>
        
        <Grid x:Name="UsernameGrid"
              Visibility="Hidden">
            <Grid.Background>

                <ImageBrush ImageSource="/cybersecurity_dark_blue_background.jpg"/>

            </Grid.Background>

            <Image Source="/cybersecurity_ai_chatbot_logo.jpg"
                Height="250"
                Width="250"
                Margin="-900,0,0,400">

                                <Image.Clip>
                                    <EllipseGeometry Center="125,125"
                                  RadiusX="110"
                                  RadiusY="110"/>
                                </Image.Clip>



            </Image>



            <TextBlock 
    Text="Enter your username" 
    FontSize="25"
    HorizontalAlignment="Center"
    Margin="0,80,0,0"
    Foreground="WhiteSmoke"
    FontFamily="Segoe Print"            />

            <Border CornerRadius="15"
        Background="White"
        Width="300"
        Height="40"
        Margin="0,0,0,90"
        BorderBrush="Gray"
        BorderThickness="1">

                <TextBox x:Name="UsernameTextBox"
             FontSize="20"
             Foreground="Gray"
             FontFamily="Segoe Print"
             Background="Transparent"
             BorderThickness="0"
             VerticalContentAlignment="Center"
             Padding="10,0"/>
                
            </Border>

            <Button x:Name="SubmitButton"
                    Height="40"
                    Width="200"
                    Content="Submit"
                    Click="SubmitButton_Click"
                    FontSize="15"
                    FontFamily="Segoe Print"
                    FontWeight="ExtraLight"
                    Cursor="Hand"
                    ToolTip="Submit Username"
                    ToolTipService.InitialShowDelay="100"
                    >
                <Button.Effect>
                    <DropShadowEffect BlurRadius="20"
           ShadowDepth="0"
           Opacity="0.5"
           Color="Wheat"/>
                </Button.Effect>

                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Black"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderBrush" Value="#2AA8FF"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="FontWeight" Value="Medium"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E7FCB"/>
                                <Setter Property="BorderBrush" Value="#1E7FCB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1669A3"/>
                                <Setter Property="BorderBrush" Value="#1669A3"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    CornerRadius="12"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>


            </Button>

        </Grid>

        <Grid x:Name="ChatGrid"
              Visibility="Hidden">

            <Grid.Background>

                <ImageBrush ImageSource="/cybersecurity_dark_blue_background.jpg"/>

            </Grid.Background>




            <Border CornerRadius="15"
        Margin="20"
        Height="400"
        Width="1000"
        Background="#0D0F14"
        BorderThickness="1.5"
        BorderBrush="#2AA8FF"
        Padding="10">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="30"
                          ShadowDepth="0"
                          Opacity="0.25"
                          Color="Wheat"/>
                </Border.Effect>

                <!-- Clips content to rounded corners -->
                <Border.Clip>
                    <RectangleGeometry RadiusX="15" RadiusY="15"
                           Rect="0,0,1000,400"/>
                </Border.Clip>

                <ListView x:Name="chats_list"
              Background="Transparent"
              BorderThickness="0"
              FontSize="15"
              FontFamily="Segoe Print"
              FontWeight="ExtraLight"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <!-- Optional spacing between chat items -->
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Margin" Value="0,5,0,5"/>
                            <Setter Property="Padding" Value="8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="1.5"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                </ListView>
            </Border>

            <Border CornerRadius="33"
        Background="#0D0F14"
        BorderBrush="#2AA8FF"
        BorderThickness="1.5"
        Height="70"
        Width="900"
        Margin="-40,500,50,0"  >
                
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                          ShadowDepth="0"
                          Opacity="0.25"
                          Color="#2AA8FF"/>
                    </Border.Effect>

                    <TextBox x:Name="chat_input"
             Background="Transparent"
             BorderThickness="0"
             CaretBrush="LightBlue"
             Foreground="LightBlue"
             FontSize="25"
             FontFamily="Segoe UI"  
             TextWrapping="Wrap"
             VerticalContentAlignment="Center"
             VerticalScrollBarVisibility="Auto"                
             Padding="20,0"
             ToolTip="Enter your prompt here..."  
             ToolTipService.InitialShowDelay="100"
             ToolTipService.BetweenShowDelay="500"
             ToolTipService.ShowDuration="5000"                
              />
            </Border>



            <Button 
                Height="50"
                Width="50"
                HorizontalAlignment="Center"
                Margin="770,500,50,0"
                Content="⬆️"
                FontWeight="Medium"
                FontSize="35"
                Click="SendMessageButton"
                BorderThickness="1"
                Cursor="Hand"
                ToolTip="Send Prompt"
                ToolTipService.InitialShowDelay="100"
                ToolTipService.BetweenShowDelay="500"
                ToolTipService.ShowDuration="5000">

                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Black"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderBrush" Value="#2AA8FF"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="FontWeight" Value="Medium"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E7FCB"/>
                                <Setter Property="BorderBrush" Value="#1E7FCB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1669A3"/>
                                <Setter Property="BorderBrush" Value="#1669A3"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    CornerRadius="50"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>


            </Button>



        </Grid>
    </Grid>
</Window>
