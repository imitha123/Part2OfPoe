<Window x:Class="Part2OfPoe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Part2OfPoe"

        mc:Ignorable="d"
        Title="ChatBot" Height="450" Width="800"
  
        >
    <Grid>

        <Grid x:Name="WelcomeGrid"
              Visibility="Visible"
              >

            <Grid.Background>

                <ImageBrush ImageSource="/cybersecurity_dark_blue_background.jpg"/>
                
            </Grid.Background>

            <Image Source="/cybersecurity_ai_chatbot_logo.jpg"
       Height="250"
       Width="250"
       Margin="0,0,0,150">

                <Image.Clip>
                    <EllipseGeometry Center="125,125"
                         RadiusX="115"
                         RadiusY="115"/>
                </Image.Clip>

            </Image>

            <Button 
                Content="Start ChatBot" 
                Height="50" Width="250"
                Margin="0,170,0,0"
                Click="start_ai"
                FontFamily="Segoe Print"
                FontSize="15"
                Cursor="Hand">
                
                <Button.Effect>
                    <DropShadowEffect BlurRadius="15"
                          ShadowDepth="3"
                          Opacity="0.4"/>
                </Button.Effect>

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    CornerRadius="12"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>


            </Button>


        </Grid>
        
        <Grid x:Name="UsernameGrid"
              Visibility="Hidden">
            <Grid.Background>

                <ImageBrush ImageSource="/cybersecurity_dark_blue_background.jpg"/>

            </Grid.Background>




            <TextBlock 
    Text="Enter your username" 
    FontSize="25"
    HorizontalAlignment="Center"
    Margin="0,80,0,0"
    Foreground="WhiteSmoke"
    FontFamily="Segoe Print"            />

            <Border CornerRadius="15"
        Background="White"
        Width="300"
        Height="40"
        Margin="0,0,0,90"
        BorderBrush="Gray"
        BorderThickness="1">

                <TextBox x:Name="UsernameTextBox"
             FontSize="20"
             Foreground="Gray"
             FontFamily="Segoe Print"
             Background="Transparent"
             BorderThickness="0"
             VerticalContentAlignment="Center"
             Padding="10,0"/>
                
            </Border>

            <Button x:Name="SubmitButton"
                    Height="40"
                    Width="200"
                    Content="Submit"
                    Click="SubmitButton_Click"
                    FontSize="15"
                    FontFamily="Segoe Print"
                    FontWeight="ExtraLight"
                    Cursor="Hand"
                    >
                <Button.Effect>
                    <DropShadowEffect BlurRadius="15"
           ShadowDepth="3"
           Opacity="0.4"/>
                </Button.Effect>

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    CornerRadius="12"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>


            </Button>

        </Grid>

        <Grid x:Name="ChatGrid"
              Visibility="Hidden">

            <Grid.Background>

                <ImageBrush ImageSource="/cybersecurity_dark_blue_background.jpg"/>

            </Grid.Background>




            <Border CornerRadius="15"
        Margin="20"
        Height="400"
        Width="1000"
        Background="#0D0F14"
        BorderThickness="1.5"
        BorderBrush="#2AA8FF"
        Padding="10">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                          ShadowDepth="0"
                          Opacity="0.25"
                          Color="#2AA8FF"/>
                </Border.Effect>

                <!-- Clips content to rounded corners -->
                <Border.Clip>
                    <RectangleGeometry RadiusX="15" RadiusY="15"
                           Rect="0,0,1000,400"/>
                </Border.Clip>

                <ListView x:Name="chats_list"
              Background="Transparent"
              BorderThickness="0"
              FontSize="15"
              FontFamily="Segoe Print"
              FontWeight="ExtraLight"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <!-- Optional spacing between chat items -->
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Margin" Value="0,5,0,5"/>
                            <Setter Property="Padding" Value="8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                </ListView>
            </Border>

            <Border CornerRadius="15"
        Background="White"
        Height="50"
        Width="700"
        Margin="-250,500,0,0"
        BorderBrush="Gray"
        BorderThickness="1">

                <TextBox x:Name="chat_input"
             FontSize="25"
             Background="Transparent"
             BorderThickness="0"
             FontFamily="Segoe Print"
             FontWeight="ExtraLight"
             VerticalContentAlignment="Center"
             Padding="10,0"/>
            </Border>



            <Button 
                Height="50"
                Width="150"
                Background="Black"
                Foreground="Beige"
                HorizontalAlignment="Center"
                Margin="700,500,50,0"
                Content="⬆️"
                FontWeight="Medium"
                FontSize="35"
                Click="SendMessageButton"
                BorderBrush="Black"
                BorderThickness="2"
                Cursor="Hand">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    CornerRadius="12"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>


            </Button>



        </Grid>
    </Grid>
</Window>
